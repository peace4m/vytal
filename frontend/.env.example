# VYTAL Frontend Environment Configuration Template
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_DEFAULT_LANGUAGE=en

# Supabase Auth Configuration (Client Public Anon Key)
# When omitted or left as placeholder, VYTAL runs seamlessly in verified local in-browser mode.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
