# ==============================================================================
# VYTAL Platform Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your local environment.
# Never commit real credentials, production secrets, or API keys.

# Environment Mode
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Application Metadata
APP_NAME=VYTAL
APP_VERSION=0.1.0
APP_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://vytal_user:vytal_password@localhost:5432/vytal_db
# Test Database URL (SQLite allowed for isolated unit/integration tests)
TEST_DATABASE_URL=sqlite:///./test.db

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Server Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_DEFAULT_LANGUAGE=en

# Security and Rate Limiting
MAX_UPLOAD_SIZE_MB=5
RATE_LIMIT_PER_MINUTE=60
SESSION_EXPIRATION_HOURS=24

# External Healthcare Normalization APIs (Optional / Cached)
# RxNorm API Base URL (public NIH service, no API key required)
RXNORM_API_BASE_URL=https://rxnav.nlm.nih.gov/REST
# openFDA API Base URL (public FDA service, optional API key for higher rate limits)
OPENFDA_API_BASE_URL=https://api.fda.gov/drug
OPENFDA_API_KEY=

# Machine Learning & Research Engine
ML_RANDOM_SEED=42
ML_MODEL_REGISTRY_DIR=./ml/models

# ==============================================================================
# Supabase Authentication & Security Configuration
# ==============================================================================
# 1. Supabase Project Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Backend JWT Cryptographic Verification (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_AUDIENCE=authenticated

# 3. Third-Party Identity Providers (configure in Supabase Dashboard -> Authentication -> Providers)
# Google OAuth: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Apple Sign In: Apple Developer -> Certificates, Identifiers & Profiles -> Services IDs
# Authorized Redirect URI: https://<your-project-id>.supabase.co/auth/v1/callback
